---
/** Button / button-styled link (Design Brief §5.5). Contact buttons always pair the icon with a text label. */
import type { IconName } from "../lib/icons";
import Icon from "./Icon.astro";

interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  block?: boolean;
  icon?: IconName;
  iconAfter?: IconName;
  /** Opens in a new tab (social profiles, maps). */
  external?: boolean;
  type?: "button" | "submit";
  class?: string;
  attrs?: Record<string, string | boolean | undefined>;
}
const {
  href,
  variant = "primary",
  size = "md",
  block = false,
  icon,
  iconAfter,
  external = false,
  type = "button",
  class: className,
  attrs = {},
} = Astro.props;
const classes = ["btn", `btn--${variant}`, size !== "md" && `btn--${size}`, block && "btn--block", className];
---

{href ? (
  <a class:list={classes} href={href} {...(external ? { target: "_blank", rel: "noopener" } : {})} {...attrs}>
    {icon && <Icon name={icon} />}
    <slot />
    {iconAfter && <Icon name={iconAfter} />}
  </a>
) : (
  <button class:list={classes} type={type} {...attrs}>
    {icon && <Icon name={icon} />}
    <slot />
    {iconAfter && <Icon name={iconAfter} />}
  </button>
)}
