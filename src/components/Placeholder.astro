---
/**
 * A slot for a photo AKHI hasn't supplied yet. Placeholders are never published (CLAUDE.md §5: no stock or
 * AI images, and no empty "photo" boxes either): rendering one fails the build, so content or a page that
 * still needs a photo stays off the site until a real AKHI photo is added.
 */
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
  label: string;
  ratio?: string | undefined;
  class?: string | undefined;
  variant?: "alt" | "scene" | "map";
  attrs?: Record<string, string | number | undefined>;
}
const { label } = Astro.props;
throw new Error(
  `No publishable AKHI photo for "${label}" on ${Astro.url.pathname}. ` +
    `Add a real photo (src/data/photos.ts + media/asset-register.csv), or remove the content that needs it.`,
);
---
