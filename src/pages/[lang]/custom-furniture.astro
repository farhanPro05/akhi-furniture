---
/** Custom Furniture (Master Plan §7.4, design/pages/custom-furniture.html). */
import BriefHelper from "../../components/BriefHelper.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Btn from "../../components/Btn.astro";
import CtaBand from "../../components/CtaBand.astro";
import CustomList from "../../components/CustomList.astro";
import FaqList from "../../components/FaqList.astro";
import Icon from "../../components/Icon.astro";
import Photo from "../../components/Photo.astro";
import SectionHead from "../../components/SectionHead.astro";
import Steps from "../../components/Steps.astro";
import { dict } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { contactTrack } from "../../lib/analytics";
import { getFaqs } from "../../lib/content";
import type { IconName } from "../../lib/icons";
import { contactLinks } from "../../lib/links";
import { langParam, langPaths } from "../../lib/paths";
import { localUrl } from "../../lib/urls";

export const getStaticPaths = langPaths;
const lang = langParam(Astro.params.lang);
const d = dict(lang);
const c = d.custom;
const links = contactLinks(lang);
const faqs = await getFaqs("custom");
const designs = localUrl(lang, "designs");

// "What we make": icon + where the tile leads
const make: { icon: IconName; href: string }[] = [
  { icon: "bed", href: `${designs}?type=beds` },
  { icon: "sofa", href: `${designs}?type=sofas` },
  { icon: "dining", href: `${designs}?type=dining-sets` },
  { icon: "wardrobe", href: `${designs}?type=wardrobes` },
  { icon: "dresser", href: `${designs}?type=dressing-tables` },
  { icon: "showcase", href: `${designs}?type=showcases` },
  { icon: "chair", href: `${designs}?type=tables` },
  { icon: "sparkle", href: "#brief" },
];
const choiceIcons: IconName[] = ["ruler", "wood", "finish", "fabric", "storage", "sparkle"];
---

<BaseLayout
  lang={lang}
  title={c.title}
  description={c.description}
  current="custom"
  crumbs={[{ label: c.title, href: localUrl(lang, "custom-furniture") }]}
>
  <div class="container">
    <Breadcrumbs lang={lang} current={c.title} />
    <section class="inner-hero" aria-labelledby="ch-title">
      <div class="inner-hero__copy">
        <p class="t-eyebrow">{c.eyebrow}</p>
        <h1 class="t-display" id="ch-title">
          {c.heroTitle}
        </h1>
        <p class="t-body-lg">{c.heroText}</p>
        <div class="btn-row">
          <Btn href="#brief" size="lg" icon="edit">
            {c.startBrief}
          </Btn>
          <Btn href={links.whatsapp} variant="secondary" size="lg" icon="whatsapp" attrs={contactTrack("whatsapp", "hero", lang)}>
            {c.justMessage}
          </Btn>
        </div>
      </div>
      <Photo id="ws-wardrobe" lang={lang} pos="50% 55%" eager sizes="(min-width: 1440px) 790px, (min-width: 1024px) 55vw, 100vw" />
    </section>
  </div>

  <section class="section section--sunken" aria-labelledby="make-title">
    <div class="container">
      <SectionHead id="make-title" eyebrow={c.makeEyebrow} title={c.makeTitle} />
      <div class="make-grid">
        {c.make.map((label, i) => (
          <a class="make" href={make[i]!.href}>
            <Icon name={make[i]!.icon} />
            <b>{label}</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="cust-title">
    <div class="split split--rev items-start">
      <Photo id="craft-carving" lang={lang} class="r-4x5" sizes="(min-width: 1440px) 560px, (min-width: 768px) 45vw, 100vw" />
      <div class="stack-lg">
        <p class="t-eyebrow">{c.choicesEyebrow}</p>
        <h2 class="t-h1" id="cust-title">
          {c.choicesTitle}
        </h2>
        <p class="t-body-lg t-muted">{c.choicesText}</p>
        <CustomList twoCol items={c.choices.map((item, i) => ({ ...item, icon: choiceIcons[i]! }))} />
      </div>
    </div>
  </section>

  <section class="section section--sunken" aria-labelledby="proc-title">
    <div class="container">
      <SectionHead id="proc-title" eyebrow={c.processEyebrow} title={c.processTitle} intro={c.processIntro} />
      <Steps lang={lang} steps={c.steps} />
    </div>
  </section>

  <section class="section container" aria-labelledby="brief-title">
    <SectionHead id="brief-title" eyebrow={d.brief.eyebrow} title={d.brief.title} intro={d.brief.intro} />
    <BriefHelper lang={lang} links={links} />
  </section>

  {faqs.length > 0 && (
    <section class="section section--sunken" aria-labelledby="cfaq-title">
      <div class="container split items-start">
        <div class="stack-lg">
          <p class="t-eyebrow">{c.faqEyebrow}</p>
          <h2 class="t-h1" id="cfaq-title">
            {c.faqTitle}
          </h2>
          <a class="link-arrow" href={localUrl(lang, "faq")}>
            {d.common.allQuestions}
            <Icon name="arrow" />
          </a>
        </div>
        <FaqList lang={lang} items={faqs} />
      </div>
    </section>
  )}

  <section class="container pb-section">
    <CtaBand dark title={c.ctaTitle} text={c.ctaText}>
      <Btn href={links.whatsapp} size="lg" icon="whatsapp" attrs={contactTrack("whatsapp", "cta_band", lang)}>
        {d.contact.discussIdea}
      </Btn>
      <Btn
        href={links.messenger}
        variant="secondary"
        size="lg"
        icon="messenger"
        external
        attrs={contactTrack("messenger", "cta_band", lang)}
      >
        {d.contact.messenger}
      </Btn>
      <Btn href={links.tel} variant="secondary" size="lg" icon="phone" attrs={contactTrack("call", "cta_band", lang)}>
        {d.contact.call}
      </Btn>
    </CtaBand>
  </section>
</BaseLayout>
