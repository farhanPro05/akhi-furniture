---
/** FAQ (Master Plan §7.10, design/pages/faq.html): grouped accordions, FAQPage structured data. */
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Btn from "../../components/Btn.astro";
import CtaBand from "../../components/CtaBand.astro";
import FaqList from "../../components/FaqList.astro";
import { dict } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { contactTrack } from "../../lib/analytics";
import { getFaqs } from "../../lib/content";
import { contactLinks } from "../../lib/links";
import { langParam, langPaths } from "../../lib/paths";
import { faqPage } from "../../lib/schema";
import { localUrl } from "../../lib/urls";

export const getStaticPaths = langPaths;
const lang = langParam(Astro.params.lang);
const d = dict(lang);
const f = d.faq;
const links = contactLinks(lang);
const faqs = await getFaqs();
const groups = (Object.keys(f.groups) as (keyof typeof f.groups)[])
  .map((key) => ({ key, title: f.groups[key], items: faqs.filter((x) => x.data.group === key) }))
  .filter((g) => g.items.length > 0);
const structured = faqPage(faqs.map((x) => ({ question: x.data.question[lang], answer: x.data.answer[lang] })));
---

<BaseLayout
  lang={lang}
  title={f.metaTitle}
  description={f.description}
  jsonLd={[structured]}
  crumbs={[{ label: f.metaTitle, href: localUrl(lang, "faq") }]}
>
  <div class="container">
    <Breadcrumbs lang={lang} current={f.metaTitle} />
    <header class="page-head">
      <h1 class="t-display">{f.title}</h1>
      <!-- prettier-ignore -->
      <p class="page-head__intro t-body-lg">{f.intro} <a class="link" href={links.whatsapp} {...contactTrack("whatsapp", "page", lang)}>{f.introLink}</a>{f.introEnd}</p>
    </header>
    <nav class="chips mb-10" aria-label={f.jumpTo}>
      {groups.map((g) => (
        <a class="chip" href={`#${g.key}`}>
          {g.title}
        </a>
      ))}
    </nav>
  </div>

  <section class="container pb-section">
    <div class="max-w-[880px]">
      {groups.map((g, i) => (
        <div class="faq-group" id={g.key}>
          <h2 class="t-h2">{g.title}</h2>
          <FaqList lang={lang} items={g.items} openFirst={i === 0} />
        </div>
      ))}
    </div>
  </section>

  <section class="container pb-section">
    <CtaBand title={f.ctaTitle}>
      <Btn href={links.whatsapp} size="lg" icon="whatsapp" attrs={contactTrack("whatsapp", "cta_band", lang)}>
        {d.contact.askOnWhatsapp}
      </Btn>
      <Btn href={links.tel} variant="secondary" size="lg" icon="phone" attrs={contactTrack("call", "cta_band", lang)}>
        {d.contact.call}
      </Btn>
    </CtaBand>
  </section>
</BaseLayout>
