---
/** Privacy notice (Master Plan §17, design/pages/privacy.html). */
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { settings } from "../../content/settings";
import { dict, fmt } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localDigits } from "../../lib/digits";
import { contactLinks } from "../../lib/links";
import { langParam, langPaths } from "../../lib/paths";
import { localUrl } from "../../lib/urls";

export const getStaticPaths = langPaths;
const lang = langParam(Astro.params.lang);
const d = dict(lang);
const p = d.privacy;
const links = contactLinks(lang);
const date = settings.privacyUpdated ? localDigits(settings.privacyUpdated, lang) : undefined;
// The analytics paragraph is only true once the Umami script is switched on
const analytics = Boolean(settings.analytics.umamiWebsiteId);
const [before, after] = p.questionsText.split("{phone}");
---

<BaseLayout
  lang={lang}
  title={p.metaTitle}
  description={analytics ? p.descriptionAnalytics : p.description}
  sticky="none"
  crumbs={[{ label: p.metaTitle, href: localUrl(lang, "privacy") }]}
>
  <div class="container pb-section">
    <Breadcrumbs lang={lang} current={p.metaTitle} />
    <header class="page-head">
      <h1 class="t-h1">{p.title}</h1>
      {date && <p class="t-caption">{fmt(p.updated, { date })}</p>}
    </header>
    <div class="prose">
      <p>{p.intro}</p>
      <h2 class="t-h2">{p.measureTitle}</h2>
      <p>{analytics ? p.measureAnalytics : p.measureNone}</p>
      <h2 class="t-h2">{p.briefTitle}</h2>
      <p>{p.briefText}</p>
      <h2 class="t-h2">{p.questionsTitle}</h2>
      <!-- prettier-ignore -->
      <p>{before}<a class="link t-num" href={links.tel}>{links.phoneDisplay}</a>{after}</p>
    </div>
  </div>
</BaseLayout>
