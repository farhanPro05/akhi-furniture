---
/**
 * Designs catalog and room pages (Master Plan §7.2, design/pages/designs.html).
 * Room chips are real links (/designs/bedroom/); type chips filter in the browser and keep ?type= in the URL.
 * Order: featured first, then by order. "Load more" appears once there are more than 24 matches.
 */
import Btn from "../components/Btn.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CtaBand from "../components/CtaBand.astro";
import DesignCard from "../components/DesignCard.astro";
import Icon from "../components/Icon.astro";
import { dict, fmt, type Lang } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactTrack } from "../lib/analytics";
import { getDesigns, getRooms, getTypes, type Room } from "../lib/content";
import { localDigits } from "../lib/digits";
import { contactLinks } from "../lib/links";
import { localUrl } from "../lib/urls";

interface Props {
  lang: Lang;
  room?: Room | undefined;
}
const { lang, room } = Astro.props;
const d = dict(lang);
const all = await getDesigns();
const rooms = await getRooms();
const designs = room ? all.filter((x) => x.data.room === room) : all;
// Type chips only for types this page actually has
const types = (await getTypes()).filter((t) => designs.some((x) => x.data.type === t));
const links = contactLinks(lang);

const title = room ? d.designs.roomTitle[room] : d.designs.title;
const intro = room ? d.designs.roomIntro[room] : d.designs.intro;
const description = room ? d.designs.roomDescription[room] : d.designs.description;
const crumbs = room
  ? [
      { label: d.nav.designs, href: localUrl(lang, "designs") },
      { label: d.rooms[room], href: localUrl(lang, `designs/${room}`) },
    ]
  : [{ label: d.nav.designs, href: localUrl(lang, "designs") }];
const n = (v: number) => localDigits(v, lang);
const countText = (count: number) => {
  if (count === 0) return d.designs.countNone;
  if (room) return fmt(count === 1 ? d.designs.countRoomOne : d.designs.countRoom, { count: n(count), room: d.designs.roomIn[room] });
  return count === 1 ? d.designs.countOne : fmt(d.designs.count, { count: n(count) });
};
---

<BaseLayout lang={lang} title={title} description={description} current="designs" crumbs={crumbs}>
  <div class="container">
    <Breadcrumbs lang={lang} trail={room ? crumbs.slice(0, 1) : []} current={room ? d.rooms[room] : d.nav.designs} />
    <header class="page-head">
      <h1 class="t-display">{title}</h1>
      <p class="page-head__intro t-body-lg">{intro}</p>
    </header>
  </div>

  <div class="container grid gap-3 pb-8">
    <div class="chips" role="group" aria-label={d.designs.roomFilter}>
      <a class="chip" href={localUrl(lang, "designs")} aria-current={room ? undefined : "page"}>
        {d.designs.allRooms} <span class="chip__count">{n(all.length)}</span>
      </a>
      {rooms.map((r) => (
        <a class="chip" href={localUrl(lang, `designs/${r.id}`)} aria-current={room === r.id ? "page" : undefined}>
          {d.rooms[r.id as Room]} <span class="chip__count">{n(all.filter((x) => x.data.room === r.id).length)}</span>
        </a>
      ))}
    </div>
    <div class="chips" role="group" aria-label={d.designs.typeFilter} data-type-filter>
      <button class="chip" type="button" aria-pressed="true" data-type="">
        {d.designs.allTypes}
      </button>
      {types.map((type) => (
        <button class="chip" type="button" aria-pressed="false" data-type={type}>
          {d.types[type]}
        </button>
      ))}
    </div>
    <div class="result-bar">
      <p
        class="t-caption"
        aria-live="polite"
        data-result-count
        data-lang={lang}
        data-none={d.designs.countNone}
        data-one={room ? fmt(d.designs.countRoomOne, { room: d.designs.roomIn[room] }) : d.designs.countOne}
        data-many={room ? fmt(d.designs.countRoom, { room: d.designs.roomIn[room] }) : d.designs.count}
      >
        {countText(designs.length)}
      </p>
      <a class="text-btn" href={localUrl(lang, "designs")} hidden={!room} data-clear>
        {d.designs.clear}
        <Icon name="x" size={16} />
      </a>
    </div>
  </div>

  <section class="container pb-section" aria-label={title}>
    <div class="card-grid" data-grid>
      {designs.map((design, i) => (
        <DesignCard design={design} lang={lang} eager={i < 2} />
      ))}
    </div>
    <div class="empty" hidden={designs.length > 0} data-empty>
      <Icon name="search" />
      <h2 class="t-h2">{d.designs.emptyTitle}</h2>
      <p class="t-muted measure">{d.designs.emptyText}</p>
      <div class="btn-row justify-center">
        <Btn href={links.whatsapp} icon="whatsapp" attrs={contactTrack("whatsapp", "empty_state", lang)}>
          {d.contact.askOnWhatsapp}
        </Btn>
        <Btn href={localUrl(lang, "designs")} variant="secondary">
          {d.designs.clear}
        </Btn>
      </div>
    </div>
    <div class="load-more" hidden data-load-more>
      <Btn variant="secondary">{d.designs.loadMore}</Btn>
    </div>
  </section>

  <section class="container pb-section">
    <CtaBand eyebrow={d.designs.ctaEyebrow} title={d.designs.ctaTitle} text={d.designs.ctaText}>
      <Btn href={links.whatsapp} size="lg" icon="whatsapp" attrs={contactTrack("whatsapp", "cta_band", lang)}>
        {d.contact.discussIdea}
      </Btn>
      <Btn href={localUrl(lang, "custom-furniture")} variant="secondary" size="lg">
        {d.designs.ctaCustom}
      </Btn>
    </CtaBand>
  </section>
</BaseLayout>

<script>
  import { $, $$ } from "../scripts/dom";

  const PAGE = 24;
  const BN = ["০", "১", "২", "৩", "৪", "৫", "৬", "৭", "৮", "৯"];
  const grid = $<HTMLElement>("[data-grid]");
  const filter = $<HTMLElement>("[data-type-filter]");
  if (grid && filter) {
    const cards = $$<HTMLElement>(".d-card", grid);
    const chips = $$<HTMLButtonElement>("[data-type]", filter);
    const count = $<HTMLElement>("[data-result-count]")!;
    const empty = $<HTMLElement>("[data-empty]")!;
    const clear = $<HTMLAnchorElement>("[data-clear]")!;
    const more = $<HTMLElement>("[data-load-more]")!;
    const roomPage = !clear.hidden;
    const digits = (v: number) => (count.dataset.lang === "bn" ? String(v).replace(/\d/g, (x) => BN[Number(x)]!) : String(v));
    let limit = PAGE;

    function render(type: string) {
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.type === type)));
      const matches = cards.filter((c) => !type || c.dataset.type === type);
      cards.forEach((c) => (c.hidden = true));
      matches.slice(0, limit).forEach((c) => (c.hidden = false));
      more.hidden = matches.length <= limit;
      empty.hidden = matches.length > 0;
      grid!.hidden = matches.length === 0;
      clear.hidden = !type && !roomPage;
      const n = matches.length;
      count.textContent = n === 0 ? count.dataset.none! : n === 1 ? count.dataset.one! : count.dataset.many!.replace("{count}", digits(n));
    }

    const current = () => new URLSearchParams(location.search).get("type") ?? "";
    filter.addEventListener("click", (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-type]");
      if (!chip) return;
      const type = chip.dataset.type ?? "";
      const url = new URL(location.href);
      if (type) url.searchParams.set("type", type);
      else url.searchParams.delete("type");
      history.replaceState(null, "", url);
      limit = PAGE;
      render(type);
    });
    more.addEventListener("click", () => {
      limit += PAGE;
      render(current());
    });
    render(current());
  }
</script>
